#!/bin/bash
set -euo pipefail

# Full upgrade first: installing into a partially upgraded system causes
# dependency conflicts between repos (e.g. cachyos vs extra on CachyOS)
sudo pacman -Syu --noconfirm --ask 4

# Install yay if not installed
if ! command -v yay &>/dev/null; then
  sudo pacman -S --needed --noconfirm git base-devel
  tmpdir=$(mktemp -d)
  git clone https://aur.archlinux.org/yay.git "$tmpdir/yay"
  (cd "$tmpdir/yay" && makepkg -si --noconfirm)
  rm -rf "$tmpdir"
fi

# Install packages from Arch repos. Kernels and microcode are left to each
# machine's installer. --ask 4 answers yes to conflict-removal prompts that
# --noconfirm would otherwise decline (e.g. pipewire-jack vs jack2)
packages=()
while IFS= read -r pkg; do
  case "$pkg" in
  "" | linux | linux-lts | intel-ucode) ;;
  *) packages+=("$pkg") ;;
  esac
done < "{{ .chezmoi.sourceDir }}/arch-packages.txt"
if [ ${#packages[@]} -gt 0 ]; then
  sudo pacman -S --needed --noconfirm --ask 4 "${packages[@]}"
fi

# Install AUR packages
mapfile -t aur_packages < "{{ .chezmoi.sourceDir }}/arch-foreign-packages.txt"
if [ ${#aur_packages[@]} -gt 0 ]; then
  yay -S --needed --noconfirm --ask 4 "${aur_packages[@]}"
fi
