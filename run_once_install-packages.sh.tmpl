#!/bin/bash
set -euo pipefail

# Full upgrade first: installing into a partially upgraded system causes
# dependency conflicts between repos (e.g. cachyos vs extra on CachyOS)
sudo pacman -Syu

# Install yay if not installed
if ! command -v yay &>/dev/null; then
  sudo pacman -S --needed --noconfirm git base-devel
  tmpdir=$(mktemp -d)
  git clone https://aur.archlinux.org/yay.git "$tmpdir/yay"
  (cd "$tmpdir/yay" && makepkg -si --noconfirm)
  rm -rf "$tmpdir"
fi

# Install packages from cachyos-packages.txt. That list is arch-packages.txt
# minus the packages CachyOS preinstalls or owns (kernel, firmware, microcode,
# bootloader, the PipeWire stack) plus the ones that hard-conflict with CachyOS
# defaults; see the header of that file for the full rationale. Comments and
# blank lines are skipped. Prompts are left interactive so any remaining
# provider choices can be resolved by hand.
packages=()
while IFS= read -r pkg; do
  case "$pkg" in
  "" | \#*) ;;
  *) packages+=("$pkg") ;;
  esac
done < "{{ .chezmoi.sourceDir }}/cachyos-packages.txt"
if [ ${#packages[@]} -gt 0 ]; then
  sudo pacman -S --needed "${packages[@]}"
fi

# Install AUR packages
mapfile -t aur_packages < "{{ .chezmoi.sourceDir }}/arch-foreign-packages.txt"
if [ ${#aur_packages[@]} -gt 0 ]; then
  yay -S --needed "${aur_packages[@]}"
fi
