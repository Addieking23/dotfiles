{
  "enabled": true,
  "sandboxUserShell": true,
  "permissionPromptTimeoutSeconds": 600,
  "network": {
    "allowLocalBinding": false,
    "allowAllUnixSockets": true,
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "npmjs.org",
      "*.npmjs.org",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pypi.org",
      "*.pypi.org",
      "files.pythonhosted.org"
    ],
    "deniedDomains": []
  },
  "filesystem": {
    "denyRead": [
      "/home",
      "/root",
      "/mnt",
      "/media",
      "/var/lib",
      "/var/log",
      "/var/spool",
      "/var/mail"
    ],
    "allowRead": [".", "~/.config/gh"],
    "allowWrite": [".", "/tmp"],
    "denyWrite": [
      ".pi/agent/sandbox.json",
      ".pi/agent/setitngs.json",
      ".pi/agent/mcp.json",
      ".pi/agent/SYSTEM.md",
      ".pi/agent/APPEND_SYSTEM.md",
      ".env",
      ".env.local",
      ".env.development",
      ".env.development.local",
      ".env.test",
      ".env.test.local",
      ".env.production",
      ".env.production.local",
      ".envrc",
      ".git/config",
      ".git/hooks",
      ".mcp.json",
      "~/.pi/agent",
      "~/.ssh",
      "~/.gnupg",
      "~/.aws",
      "~/.azure",
      "~/.config/gcloud",
      "~/.kube",
      "~/.docker",
      "~/.config/gh",
      "~/.terraform.d",
      "~/.password-store",
      "~/.local/share/keyrings",
      "~/.netrc",
      "~/.git-credentials",
      "~/.npmrc",
      "~/.pypirc",
      "~/.bashrc",
      "~/.bash_profile",
      "~/.profile",
      "~/.zshrc",
      "~/.zprofile",
      "~/.config/fish/config.fish",
      "~/.config/systemd/user",
      "~/.config/autostart",
      "~/.configh/gh",
      "/etc",
      "/boot"
    ]
  }
}
